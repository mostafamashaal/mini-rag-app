APP_NAME="mini-RAG"
APP_VERSION="0.1"

# File Config
FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000

# PostgreSQL Config
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_MAIN_DATABASE=

# LLM Config
GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="COHERE"

OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_API_URL=""
COHERE_API_KEY="YOUR_COHERE_API_KEY"

GENERATION_MODEL_ID_LITERAL = ["gemma2:9b-instruct-q5_0", "gpt-4o-mini", "gpt-4o"]
GENERATION_MODEL_ID="gemma2:9b-instruct-q5_0"
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384

DEFAULT_INPUT_MAX_CHARACTERS=1024
DEFAULT_GENERATION_MAX_TOKENS=200
DEFAULT_GENERATION_TEMPERATURE=0.1

# Vector DB Config
VECTOR_DB_BACKEND_LITERAL = ["QDRANT", "PGVECTOR"]
VECTOR_DB_BACKEND="PGVECTOR"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD = 100

# Template Config
PRIMARY_LANG = "en"
DEFAULT_LANG = "en"
